# berserk-mcp example configuration
#
# Safe default: do not set any of these unless you need the optional HTTP
# transport. berserk-mcp uses stdio by default and opens no network listener.

# Enable the optional HTTP transport.
# Default: disabled by default. Leave commented for Claude Desktop/Claude Code stdio use.
# BERSERK_MCP_HTTP_ENABLE=1

# HTTP bind address.
# Default when HTTP is enabled: 127.0.0.1:8765.
# Keep loopback when running behind a local reverse proxy.
# BERSERK_MCP_HTTP_BIND=127.0.0.1:8765

# Permit binding to a non-loopback address such as 0.0.0.0.
# Default: disabled. Remote bind also requires auth, allowed hosts, and CIDRs.
# Do not enable this for direct internet exposure.
# BERSERK_MCP_HTTP_ALLOW_REMOTE=1

# Bearer token for HTTP requests.
# Required for any non-loopback bind. Recommended even on loopback when a
# reverse proxy forwards to berserk-mcp.
# Generate a long random value, store it as a secret, and send:
# Authorization: Bearer <token>
# BERSERK_MCP_HTTP_AUTH_TOKEN=

# Host header allowlist.
# Required for any non-loopback bind. Use exact hostnames only; wildcards are
# intentionally unsupported.
# Example behind TLS proxy:
# BERSERK_MCP_HTTP_ALLOWED_HOSTS=mcp.internal.example.com

# Source IP/CIDR allowlist.
# Default: loopback only. Global allow-all CIDRs such as 0.0.0.0/0 and ::/0 are
# rejected by startup validation.
# Loopback-only proxy:
# BERSERK_MCP_HTTP_ALLOW_CIDRS=127.0.0.1/32,::1/128
# Tailscale/private overlay example:
# BERSERK_MCP_HTTP_ALLOW_CIDRS=100.64.0.0/10

# Maximum JSON request body size in bytes.
# Default: 1048576 (1 MiB). Keep small; MCP tool calls should be compact.
# BERSERK_MCP_HTTP_MAX_REQUEST_BYTES=1048576

# Maximum concurrent HTTP requests admitted to the MCP dispatcher.
# Default: 8. Excess requests receive HTTP 429.
# BERSERK_MCP_HTTP_MAX_CONCURRENT_REQUESTS=8

# Trust X-Forwarded-For from known reverse proxies.
# Default: disabled. Never enable this without TRUSTED_PROXY_CIDRS.
# BERSERK_MCP_HTTP_USE_FORWARDED_FOR=1

# CIDRs for reverse proxies whose X-Forwarded-For value should be trusted.
# Required if BERSERK_MCP_HTTP_USE_FORWARDED_FOR=1.
# Loopback reverse proxy example:
# BERSERK_MCP_HTTP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Enable gated MCP 2026-07-28 compatibility features.
# Default: disabled. Leave commented unless the client supports this newer MCP
# mode and you have tested compatibility.
# BERSERK_MCP_ENABLE_2026_07_28=1
